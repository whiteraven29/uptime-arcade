[Unit]
Description=Uptime Arcade grading worker
After=network.target redis-server.service postgresql.service docker.service
Requires=docker.service

[Service]
# Only this user can reach Docker, and the web service runs as another. Docker access amounts to root on this
# machine, so this unit never handles web requests, and runs each job in a locked-down container (docs/DEPLOYMENT.md).
User=uptime-runner
Group=uptime-runner
SupplementaryGroups=docker
WorkingDirectory=/srv/uptime-arcade/backend
EnvironmentFile=/etc/uptime-arcade/env
Environment=DJANGO_SETTINGS_MODULE=config.settings.prod
# Two sandboxes at a time, however many players press Run. The rest wait in the queue.
ExecStart=/srv/uptime-arcade/.venv/bin/celery -A config worker --concurrency=2 --max-tasks-per-child=200 --loglevel=INFO
Restart=always
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
MemoryMax=2G

[Install]
WantedBy=multi-user.target
