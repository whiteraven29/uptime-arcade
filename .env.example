# Copy to .env for local overrides. Production must set every value.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Any SMTP account. Codes for email confirmation and password resets go through it.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Uptime Arcade <no-reply@example.com>
# Rate limits and the grading queue. Set RUNNER_RUNTIME=runsc to run player code under gVisor if it's installed.
REDIS_URL=redis://127.0.0.1:6379/0
RUNNER_RUNTIME=
# A private admin path, like "manage-a8f3/". Add DJANGO_NUM_PROXIES if more than one proxy sits in front.
DJANGO_ADMIN_PATH=admin/
DJANGO_NUM_PROXIES=1
